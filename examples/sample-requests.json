          "Reset non-existent session",
          "Verify error responses"
        ]
      },
      {
        "name": "Performance",
        "steps": [
          "Concurrent requests",
          "Long conversation",
          "Memory usage check",
          "Response time measurement"
        ]
      }
    ]
  }
}
